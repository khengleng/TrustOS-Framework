# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Generate each value separately:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# These are development-only credentials for a Keycloak on your own machine. They are
# still credentials: do not reuse them anywhere else, and do not commit the .env.

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# Host port. Change it if 8080 is taken; the issuer URL must match.
KEYCLOAK_PORT=8080
