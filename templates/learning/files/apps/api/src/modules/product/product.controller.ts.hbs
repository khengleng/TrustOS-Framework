}

@ApiTags('progress')
@ApiBearerAuth('access-token')
@Controller('progress')
export class ProgressController {
  constructor(private readonly product: ProductService) {}

  @Get()
  @RequirePermissions(LEARNING_PERMISSIONS.PROGRESS_READ.key)
  @ApiOperation({
    summary: 'Progress summary per student',
    description: 'Derived on read from sessions and attempts, never stored.',
