@ApiTags('borrowers')
@ApiBearerAuth('access-token')
@Controller('borrowers')
export class BorrowerController {
  constructor(private readonly product: MicroloanService) {}

  @Get()
  @RequirePermissions(P.BORROWER_READ.key)
  @ApiOperation({ summary: 'List borrowers' })
  list(): Promise<BorrowerRow[]> {
    return this.product.listBorrowers();
  }

  @Get(':id')
  @RequirePermissions(P.BORROWER_READ.key)
  @ApiOperation({ summary: 'Read one borrower' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<BorrowerRow> {
    return this.product.findBorrower(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.BORROWER_CREATE.key)
  @ApiOperation({ summary: 'Create a borrower' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createBorrowerSchema))
    body: z.infer<typeof createBorrowerSchema>,
  ): Promise<BorrowerRow> {
    return this.product.createBorrower(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.BORROWER_UPDATE.key)
  @ApiOperation({ summary: 'Modify a borrower' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateBorrowerSchema))
    body: z.infer<typeof updateBorrowerSchema>,
  ): Promise<BorrowerRow> {
    return this.product.updateBorrower(id, body, organizationId);
  }
}

