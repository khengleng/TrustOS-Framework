// =============================================================================
// TrustOS Messenger Mini App — product models
//
// The mini app shape with a Messenger verifier: the same users, sessions,
// deep links, menu and settings, and a different platform handshake.
//
// Out of scope, deliberately: Meta Graph API calls, Facebook page
// provisioning, payment providers, push notification services, chatbot
// conversation design.
//
// `organizationId` is a scalar rather than a Prisma relation so that
// 00-framework.prisma stays replaceable on upgrade — the same trade the
// framework makes for AuditLog. Isolation comes from the tenant scope
// applied to every query, and is proven by the isolation tests.
// =============================================================================

/// The Messenger-specific facts about a mini app user. A page-scoped id is only
/// meaningful for one page — storing it without the page it belongs to makes it
/// unresolvable later.
model MessengerProfile {
  id             String @id @default(cuid())
  organizationId String
  miniAppUserId String
  pageScopedId String
  pageRef String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([organizationId, miniAppUserId])
  @@unique([organizationId, pageScopedId])
  @@index([organizationId, miniAppUserId])
  @@index([deletedAt])
}
