const createMedicalRecordEntrySchema = z.object({
  patientId: z.string().trim().min(1).max(64),
  appointmentId: z.string().trim().min(1).max(64).optional(),
  authorPractitionerId: z.string().trim().min(1).max(64),
  kind: z.enum(['CONSULTATION', 'OBSERVATION', 'PRESCRIPTION', 'REFERRAL', 'ATTACHMENT']),
  body: z.string().trim().min(1).max(4000),
  recordedAt: z.coerce.date(),
