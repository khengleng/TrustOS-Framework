  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('patients')
@ApiBearerAuth('access-token')
@Controller('patients')
export class PatientController {
  constructor(private readonly product: ClinicService) {}

  @Get()
  @RequirePermissions(P.PATIENT_READ.key)
  @ApiOperation({ summary: 'List patients' })
  list(): Promise<PatientRow[]> {
    return this.product.listPatients();
  }

  @Get(':id')
  @RequirePermissions(P.PATIENT_READ.key)
  @ApiOperation({ summary: 'Read one patient' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<PatientRow> {
    return this.product.findPatient(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.PATIENT_CREATE.key)
  @ApiOperation({ summary: 'Create a patient' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createPatientSchema))
    body: z.infer<typeof createPatientSchema>,
  ): Promise<PatientRow> {
    return this.product.createPatient(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.PATIENT_UPDATE.key)
  @ApiOperation({ summary: 'Modify a patient' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updatePatientSchema))
    body: z.infer<typeof updatePatientSchema>,
  ): Promise<PatientRow> {
    return this.product.updatePatient(id, body, organizationId);
  }
}

