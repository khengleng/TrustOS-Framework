  name: z.string().trim().min(1).max(255),
  description: z.string().trim().min(1).max(4000).optional(),
  workflowDefinitionId: z.string().trim().min(1).max(255).optional(),
  processingDays: z.coerce.number().int().optional(),
  isActive: z.coerce.boolean().optional(),
});

const updateGovernmentServiceSchema = z
