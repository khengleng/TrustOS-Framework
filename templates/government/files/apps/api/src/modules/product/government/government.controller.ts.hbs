  workflowInstanceId: z.string().trim().min(1).max(255).optional(),
  status: z.enum(['DRAFT', 'SUBMITTED', 'IN_REVIEW', 'INFORMATION_REQUESTED', 'APPROVED', 'REJECTED', 'WITHDRAWN']).optional(),
  decidedAt: z.coerce.date().optional(),
