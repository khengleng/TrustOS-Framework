@ApiTags('citizens')
@ApiBearerAuth('access-token')
@Controller('citizens')
export class CitizenController {
  constructor(private readonly product: GovernmentService) {}

  @Get()
  @RequirePermissions(P.CITIZEN_READ.key)
  @ApiOperation({ summary: 'List citizens' })
  list(): Promise<CitizenRow[]> {
    return this.product.listCitizens();
  }

  @Get(':id')
  @RequirePermissions(P.CITIZEN_READ.key)
  @ApiOperation({ summary: 'Read one citizen' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<CitizenRow> {
    return this.product.findCitizen(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.CITIZEN_CREATE.key)
  @ApiOperation({ summary: 'Create a citizen' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createCitizenSchema))
    body: z.infer<typeof createCitizenSchema>,
  ): Promise<CitizenRow> {
    return this.product.createCitizen(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.CITIZEN_UPDATE.key)
  @ApiOperation({ summary: 'Modify a citizen' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateCitizenSchema))
    body: z.infer<typeof updateCitizenSchema>,
  ): Promise<CitizenRow> {
    return this.product.updateCitizen(id, body, organizationId);
  }
}

