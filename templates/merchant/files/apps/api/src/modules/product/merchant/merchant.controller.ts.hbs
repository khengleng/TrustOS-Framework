@ApiTags('merchant-members')
@ApiBearerAuth('access-token')
@Controller('merchant-members')
export class MerchantMembersController {
  constructor(private readonly product: MerchantService) {}

  @Get()
  @RequirePermissions(MERCHANT_PERMISSIONS.MEMBER_READ.key)
  @ApiOperation({ summary: 'List merchant members' })
  list(): Promise<MerchantMemberRow[]> {
    return this.product.listMembers();
  }

  @Post()
  @RequirePermissions(MERCHANT_PERMISSIONS.MEMBER_MANAGE.key)
  @ApiOperation({ summary: 'Add a member to a merchant' })
  add(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(addMemberSchema)) body: z.infer<typeof addMemberSchema>,
  ): Promise<MerchantMemberRow> {
    return this.product.addMember(body, organizationId);
  }

  @Delete(':id')
  @HttpCode(204)
  @RequirePermissions(MERCHANT_PERMISSIONS.MEMBER_MANAGE.key)
  @ApiOperation({ summary: 'Remove a merchant member (soft delete)' })
  remove(@Param('id') id: string, @OrganizationId() organizationId: string): Promise<void> {
    return this.product.removeMember(id, organizationId);
  }
}
