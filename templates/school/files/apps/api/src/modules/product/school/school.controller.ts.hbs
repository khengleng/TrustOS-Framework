   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createGuardianSchema = z.object({
  studentId: z.string().trim().min(1).max(64),
  fullName: z.string().trim().min(1).max(255),
  relationship: z.string().trim().min(1).max(255),
  phone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
  email: z.string().trim().toLowerCase().email().max(254).optional(),
  isPrimaryContact: z.coerce.boolean().optional(),
});

const updateGuardianSchema = z
  .object({
    studentId: z.string().trim().min(1).max(64).optional(),
    fullName: z.string().trim().min(1).max(255).optional(),
    relationship: z.string().trim().min(1).max(255).optional(),
    phone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
    email: z.string().trim().toLowerCase().email().max(254).optional(),
    isPrimaryContact: z.coerce.boolean().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
