  period: z.coerce.number().int(),
  state: z.enum(['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']),
  note: z.string().trim().min(1).max(255).optional(),
});

const updateAttendanceSchema = z
  .object({
    classGroupId: z.string().trim().min(1).max(64).optional(),
    studentId: z.string().trim().min(1).max(64).optional(),
    sessionOn: z.coerce.date().optional(),
    period: z.coerce.number().int().optional(),
    state: z.enum(['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']).optional(),
    note: z.string().trim().min(1).max(255).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createGradeSchema = z.object({
  classGroupId: z.string().trim().min(1).max(64),
  studentId: z.string().trim().min(1).max(64),
  component: z.string().trim().min(1).max(255),
  marksAwarded: z.coerce.number().int(),
  maxMarks: z.coerce.number().int(),
  recordedAt: z.coerce.date(),
});

const updateGradeSchema = z
  .object({
    classGroupId: z.string().trim().min(1).max(64).optional(),
    studentId: z.string().trim().min(1).max(64).optional(),
    component: z.string().trim().min(1).max(255).optional(),
    marksAwarded: z.coerce.number().int().optional(),
    maxMarks: z.coerce.number().int().optional(),
    recordedAt: z.coerce.date().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
