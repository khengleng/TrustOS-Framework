  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('academic-terms')
@ApiBearerAuth('access-token')
@Controller('academic-terms')
export class AcademicTermController {
  constructor(private readonly product: SchoolService) {}

  @Get()
  @RequirePermissions(P.ACADEMIC_TERM_READ.key)
  @ApiOperation({ summary: 'List terms' })
  list(): Promise<AcademicTermRow[]> {
    return this.product.listAcademicTerms();
  }

  @Get(':id')
  @RequirePermissions(P.ACADEMIC_TERM_READ.key)
  @ApiOperation({ summary: 'Read one term' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<AcademicTermRow> {
    return this.product.findAcademicTerm(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.ACADEMIC_TERM_CREATE.key)
  @ApiOperation({ summary: 'Create a term' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createAcademicTermSchema))
    body: z.infer<typeof createAcademicTermSchema>,
  ): Promise<AcademicTermRow> {
    return this.product.createAcademicTerm(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.ACADEMIC_TERM_UPDATE.key)
  @ApiOperation({ summary: 'Modify a term' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateAcademicTermSchema))
    body: z.infer<typeof updateAcademicTermSchema>,
  ): Promise<AcademicTermRow> {
    return this.product.updateAcademicTerm(id, body, organizationId);
  }
}

