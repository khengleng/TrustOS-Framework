# Railway configuration for {{productDisplayName}}.
#
# Set this file as the service's "Config as code" path in Railway settings.
# Deploying from the CLI (`railway up`) does not read it — see docs/deployment.md
# for the RAILPACK_* variables to set instead.

[build]
builder = "RAILPACK"
buildCommand = "npm ci && npm run build"

[deploy]
startCommand = "node apps/api/dist/main.js"
# Migrations run once per deploy, before new instances take traffic.
preDeployCommand = "npm run db:deploy"
# Liveness, not readiness: /health must not depend on the database, or a brief
# database outage turns into a restart loop.
healthcheckPath = "/health"
healthcheckTimeout = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 5
numReplicas = 1
