   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createOrderLineSchema = z.object({
  orderId: z.string().trim().min(1).max(64),
  variantId: z.string().trim().min(1).max(64),
  description: z.string().trim().min(1).max(255),
  quantity: z.coerce.number().int(),
  unitPrice: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  lineTotal: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
});

const updateOrderLineSchema = z
  .object({
    orderId: z.string().trim().min(1).max(64).optional(),
    variantId: z.string().trim().min(1).max(64).optional(),
    description: z.string().trim().min(1).max(255).optional(),
    quantity: z.coerce.number().int().optional(),
    unitPrice: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    lineTotal: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('catalogs')
@ApiBearerAuth('access-token')
@Controller('catalogs')
export class CatalogController {
  constructor(private readonly product: EcommerceService) {}

  @Get()
  @RequirePermissions(P.CATALOG_READ.key)
  @ApiOperation({ summary: 'List catalogs' })
  list(): Promise<CatalogRow[]> {
    return this.product.listCatalogs();
  }

  @Get(':id')
  @RequirePermissions(P.CATALOG_READ.key)
  @ApiOperation({ summary: 'Read one catalog' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<CatalogRow> {
    return this.product.findCatalog(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.CATALOG_CREATE.key)
  @ApiOperation({ summary: 'Create a catalog' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createCatalogSchema))
    body: z.infer<typeof createCatalogSchema>,
  ): Promise<CatalogRow> {
    return this.product.createCatalog(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.CATALOG_UPDATE.key)
  @ApiOperation({ summary: 'Modify a catalog' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateCatalogSchema))
    body: z.infer<typeof updateCatalogSchema>,
  ): Promise<CatalogRow> {
    return this.product.updateCatalog(id, body, organizationId);
  }
}

