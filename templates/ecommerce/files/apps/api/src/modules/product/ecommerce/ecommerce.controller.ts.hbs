  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createProductVariantSchema = z.object({
  productId: z.string().trim().min(1).max(64),
  name: z.string().trim().min(1).max(255),
  sku: z.string().trim().min(1).max(255),
  price: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  currency: z.string().trim().min(1).max(255),
  isActive: z.coerce.boolean().optional(),
});

const updateProductVariantSchema = z
  .object({
    productId: z.string().trim().min(1).max(64).optional(),
    name: z.string().trim().min(1).max(255).optional(),
    sku: z.string().trim().min(1).max(255).optional(),
    price: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    isActive: z.coerce.boolean().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createOrderSchema = z.object({
  storeId: z.string().trim().min(1).max(64),
  reference: z.string().trim().min(1).max(255),
  customerName: z.string().trim().min(1).max(255),
  customerPhone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
  status: z.enum(['PENDING', 'CONFIRMED', 'FULFILLED', 'CANCELLED', 'REFUNDED']).optional(),
  total: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  currency: z.string().trim().min(1).max(255),
  placedAt: z.coerce.date(),
});

const updateOrderSchema = z
  .object({
    storeId: z.string().trim().min(1).max(64).optional(),
    customerName: z.string().trim().min(1).max(255).optional(),
    customerPhone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
    status: z.enum(['PENDING', 'CONFIRMED', 'FULFILLED', 'CANCELLED', 'REFUNDED']).optional(),
    total: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    placedAt: z.coerce.date().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
