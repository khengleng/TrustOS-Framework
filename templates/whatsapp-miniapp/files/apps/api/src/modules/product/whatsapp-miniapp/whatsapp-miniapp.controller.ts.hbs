import { Body, Controller, Get, Param, Patch, Post } from '@nestjs/common';
import { ApiBearerAuth, ApiOperation, ApiTags } from '@nestjs/swagger';
import { RequirePermissions } from '@trustos/rbac';
import { OrganizationId } from '@trustos/tenancy';
import { z } from '@trustos/validation';
import { ZodValidationPipe } from '@trustos/validation/nest';
import { WHATSAPP_MINIAPP_PERMISSIONS as P } from '{{packageName}}-product-domain';
import {
  WhatsappMiniappService,
  type WhatsAppProfileRow,
} from './whatsapp-miniapp.service';

/**
 * TrustOS WhatsApp Mini App endpoints.
 *
 * Every route declares a permission — `PermissionsGuard` denies any route that declares none —
 * and the key is the same constant the admin console reads to decide whether to show the screen.
 * A guard and a menu reading different lists disagree, and the disagreement is always in the
 * direction of showing somebody a screen that then refuses them.
 *
 * The organization always comes from `@OrganizationId()`, which reads what the tenant guard
 * derived from the access token. It is never read from a path, a body or a header — a tenant id
 * a caller can supply is not a tenant boundary.
 */

const createWhatsAppProfileSchema = z.object({
  miniAppUserId: z.string().trim().min(1).max(64),
  waId: z.string().trim().min(1).max(255),
  phone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/),
  businessAccountRef: z.string().trim().min(1).max(255).optional(),
});

const updateWhatsAppProfileSchema = z
  .object({
    miniAppUserId: z.string().trim().min(1).max(64).optional(),
    phone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
    businessAccountRef: z.string().trim().min(1).max(255).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('whats-app-profiles')
@ApiBearerAuth('access-token')
@Controller('whats-app-profiles')
export class WhatsAppProfileController {
  constructor(private readonly product: WhatsappMiniappService) {}

  @Get()
  @RequirePermissions(P.WHATS_APP_PROFILE_READ.key)
  @ApiOperation({ summary: 'List whatsapp profiles' })
  list(): Promise<WhatsAppProfileRow[]> {
    return this.product.listWhatsAppProfiles();
  }

  @Get(':id')
  @RequirePermissions(P.WHATS_APP_PROFILE_READ.key)
  @ApiOperation({ summary: 'Read one whatsapp profile' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<WhatsAppProfileRow> {
    return this.product.findWhatsAppProfile(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.WHATS_APP_PROFILE_CREATE.key)
  @ApiOperation({ summary: 'Create a whatsapp profile' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createWhatsAppProfileSchema))
    body: z.infer<typeof createWhatsAppProfileSchema>,
  ): Promise<WhatsAppProfileRow> {
    return this.product.createWhatsAppProfile(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.WHATS_APP_PROFILE_UPDATE.key)
  @ApiOperation({ summary: 'Modify a whatsapp profile' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateWhatsAppProfileSchema))
    body: z.infer<typeof updateWhatsAppProfileSchema>,
  ): Promise<WhatsAppProfileRow> {
    return this.product.updateWhatsAppProfile(id, body, organizationId);
  }
}
