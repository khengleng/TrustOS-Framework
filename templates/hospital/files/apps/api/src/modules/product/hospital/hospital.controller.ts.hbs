import { Body, Controller, Get, Param, Patch, Post } from '@nestjs/common';
import { ApiBearerAuth, ApiOperation, ApiTags } from '@nestjs/swagger';
import { RequirePermissions } from '@trustos/rbac';
import { OrganizationId } from '@trustos/tenancy';
import { z } from '@trustos/validation';
import { ZodValidationPipe } from '@trustos/validation/nest';
import { HOSPITAL_PERMISSIONS as P } from '{{packageName}}-product-domain';
import {
  HospitalService,
  type HospitalDepartmentRow,
  type WardRow,
  type BedRow,
  type AdmissionRow,
} from './hospital.service';

/**
 * TrustOS Hospital endpoints.
 *
 * Every route declares a permission — `PermissionsGuard` denies any route that declares none —
 * and the key is the same constant the admin console reads to decide whether to show the screen.
 * A guard and a menu reading different lists disagree, and the disagreement is always in the
 * direction of showing somebody a screen that then refuses them.
 *
 * The organization always comes from `@OrganizationId()`, which reads what the tenant guard
 * derived from the access token. It is never read from a path, a body or a header — a tenant id
 * a caller can supply is not a tenant boundary.
 */

const createHospitalDepartmentSchema = z.object({
  name: z.string().trim().min(1).max(255),
  code: z.string().trim().toLowerCase().min(2).max(64).regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/),
  headPractitionerId: z.string().trim().min(1).max(64).optional(),
  isActive: z.coerce.boolean().optional(),
});

const updateHospitalDepartmentSchema = z
  .object({
    name: z.string().trim().min(1).max(255).optional(),
    headPractitionerId: z.string().trim().min(1).max(64).optional(),
    isActive: z.coerce.boolean().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createWardSchema = z.object({
  departmentId: z.string().trim().min(1).max(64),
  name: z.string().trim().min(1).max(255),
  code: z.string().trim().toLowerCase().min(2).max(64).regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/),
  bedCount: z.coerce.number().int(),
});

const updateWardSchema = z
  .object({
    departmentId: z.string().trim().min(1).max(64).optional(),
    name: z.string().trim().min(1).max(255).optional(),
    bedCount: z.coerce.number().int().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createBedSchema = z.object({
  wardId: z.string().trim().min(1).max(64),
  label: z.string().trim().min(1).max(255),
  status: z.enum(['AVAILABLE', 'OCCUPIED', 'CLEANING', 'OUT_OF_SERVICE']).optional(),
});

const updateBedSchema = z
  .object({
    wardId: z.string().trim().min(1).max(64).optional(),
    label: z.string().trim().min(1).max(255).optional(),
    status: z.enum(['AVAILABLE', 'OCCUPIED', 'CLEANING', 'OUT_OF_SERVICE']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createAdmissionSchema = z.object({
  patientId: z.string().trim().min(1).max(64),
  bedId: z.string().trim().min(1).max(64),
  admittingPractitionerId: z.string().trim().min(1).max(64),
  reference: z.string().trim().min(1).max(255),
  admittedAt: z.coerce.date(),
  dischargedAt: z.coerce.date().optional(),
  status: z.enum(['ADMITTED', 'TRANSFERRED', 'DISCHARGED']).optional(),
});

const updateAdmissionSchema = z
  .object({
    patientId: z.string().trim().min(1).max(64).optional(),
    bedId: z.string().trim().min(1).max(64).optional(),
    admittingPractitionerId: z.string().trim().min(1).max(64).optional(),
    admittedAt: z.coerce.date().optional(),
    dischargedAt: z.coerce.date().optional(),
    status: z.enum(['ADMITTED', 'TRANSFERRED', 'DISCHARGED']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('hospital-departments')
@ApiBearerAuth('access-token')
@Controller('hospital-departments')
export class HospitalDepartmentController {
  constructor(private readonly product: HospitalService) {}

  @Get()
  @RequirePermissions(P.HOSPITAL_DEPARTMENT_READ.key)
  @ApiOperation({ summary: 'List departments' })
  list(): Promise<HospitalDepartmentRow[]> {
    return this.product.listHospitalDepartments();
  }

  @Get(':id')
  @RequirePermissions(P.HOSPITAL_DEPARTMENT_READ.key)
  @ApiOperation({ summary: 'Read one department' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<HospitalDepartmentRow> {
    return this.product.findHospitalDepartment(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.HOSPITAL_DEPARTMENT_CREATE.key)
  @ApiOperation({ summary: 'Create a department' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createHospitalDepartmentSchema))
    body: z.infer<typeof createHospitalDepartmentSchema>,
  ): Promise<HospitalDepartmentRow> {
    return this.product.createHospitalDepartment(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.HOSPITAL_DEPARTMENT_UPDATE.key)
  @ApiOperation({ summary: 'Modify a department' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateHospitalDepartmentSchema))
    body: z.infer<typeof updateHospitalDepartmentSchema>,
  ): Promise<HospitalDepartmentRow> {
    return this.product.updateHospitalDepartment(id, body, organizationId);
  }
}

