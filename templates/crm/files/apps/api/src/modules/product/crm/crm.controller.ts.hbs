@ApiTags('customers')
@ApiBearerAuth('access-token')
@Controller('customers')
export class CustomerController {
  constructor(private readonly product: CrmService) {}

  @Get()
  @RequirePermissions(P.CUSTOMER_READ.key)
  @ApiOperation({ summary: 'List customers' })
  list(): Promise<CustomerRow[]> {
    return this.product.listCustomers();
  }

  @Get(':id')
  @RequirePermissions(P.CUSTOMER_READ.key)
  @ApiOperation({ summary: 'Read one customer' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<CustomerRow> {
    return this.product.findCustomer(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.CUSTOMER_CREATE.key)
  @ApiOperation({ summary: 'Create a customer' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createCustomerSchema))
    body: z.infer<typeof createCustomerSchema>,
  ): Promise<CustomerRow> {
    return this.product.createCustomer(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.CUSTOMER_UPDATE.key)
  @ApiOperation({ summary: 'Modify a customer' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateCustomerSchema))
    body: z.infer<typeof updateCustomerSchema>,
  ): Promise<CustomerRow> {
    return this.product.updateCustomer(id, body, organizationId);
  }
}

