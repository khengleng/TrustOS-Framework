@ApiTags('teachers')
@ApiBearerAuth('access-token')
@Controller('teachers')
export class TeacherController {
  constructor(private readonly product: EducationService) {}

  @Get()
  @RequirePermissions(P.TEACHER_READ.key)
  @ApiOperation({ summary: 'List teachers' })
  list(): Promise<TeacherRow[]> {
    return this.product.listTeachers();
  }

  @Get(':id')
  @RequirePermissions(P.TEACHER_READ.key)
  @ApiOperation({ summary: 'Read one teacher' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<TeacherRow> {
    return this.product.findTeacher(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.TEACHER_CREATE.key)
  @ApiOperation({ summary: 'Create a teacher' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createTeacherSchema))
    body: z.infer<typeof createTeacherSchema>,
  ): Promise<TeacherRow> {
    return this.product.createTeacher(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.TEACHER_UPDATE.key)
  @ApiOperation({ summary: 'Modify a teacher' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateTeacherSchema))
    body: z.infer<typeof updateTeacherSchema>,
  ): Promise<TeacherRow> {
    return this.product.updateTeacher(id, body, organizationId);
  }
}

