    name: z.string().trim().min(1).max(255).optional(),
    karat: z.enum(['K10', 'K14', 'K18', 'K21', 'K22', 'K24']).optional(),
    grossWeightGrams: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    goldWeightGrams: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    labourCost: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    status: z.enum(['IN_STOCK', 'RESERVED', 'SOLD', 'MELTED']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createGoldOrderSchema = z.object({
  reference: z.string().trim().min(1).max(255),
  itemId: z.string().trim().min(1).max(64),
  priceId: z.string().trim().min(1).max(64),
  direction: z.enum(['SELL_TO_CUSTOMER', 'BUY_FROM_CUSTOMER']),
  customerName: z.string().trim().min(1).max(255),
  customerPhone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
  goldValue: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  labourCost: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  total: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  currency: z.string().trim().min(1).max(255),
  status: z.enum(['DRAFT', 'CONFIRMED', 'SETTLED', 'CANCELLED']).optional(),
});

const updateGoldOrderSchema = z
  .object({
    itemId: z.string().trim().min(1).max(64).optional(),
    priceId: z.string().trim().min(1).max(64).optional(),
    direction: z.enum(['SELL_TO_CUSTOMER', 'BUY_FROM_CUSTOMER']).optional(),
    customerName: z.string().trim().min(1).max(255).optional(),
    customerPhone: z.string().trim().min(6).max(24).regex(/^[+()\-. \d]+$/).optional(),
    goldValue: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    labourCost: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    total: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    status: z.enum(['DRAFT', 'CONFIRMED', 'SETTLED', 'CANCELLED']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createGoldInvoiceSchema = z.object({
  orderId: z.string().trim().min(1).max(64),
  number: z.string().trim().min(1).max(255),
  issuedAt: z.coerce.date(),
  total: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  currency: z.string().trim().min(1).max(255),
  status: z.enum(['ISSUED', 'PAID', 'VOID']).optional(),
});

const updateGoldInvoiceSchema = z
  .object({
    orderId: z.string().trim().min(1).max(64).optional(),
    issuedAt: z.coerce.date().optional(),
    total: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    status: z.enum(['ISSUED', 'PAID', 'VOID']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('gold-prices')
@ApiBearerAuth('access-token')
@Controller('gold-prices')
export class GoldPriceController {
  constructor(private readonly product: GoldShopService) {}

  @Get()
  @RequirePermissions(P.GOLD_PRICE_READ.key)
  @ApiOperation({ summary: 'List price quotes' })
  list(): Promise<GoldPriceRow[]> {
    return this.product.listGoldPrices();
  }

  @Get(':id')
  @RequirePermissions(P.GOLD_PRICE_READ.key)
  @ApiOperation({ summary: 'Read one price quote' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<GoldPriceRow> {
    return this.product.findGoldPrice(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.GOLD_PRICE_CREATE.key)
  @ApiOperation({ summary: 'Create a price quote' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createGoldPriceSchema))
    body: z.infer<typeof createGoldPriceSchema>,
  ): Promise<GoldPriceRow> {
    return this.product.createGoldPrice(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.GOLD_PRICE_UPDATE.key)
  @ApiOperation({ summary: 'Modify a price quote' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateGoldPriceSchema))
    body: z.infer<typeof updateGoldPriceSchema>,
  ): Promise<GoldPriceRow> {
    return this.product.updateGoldPrice(id, body, organizationId);
  }
}

