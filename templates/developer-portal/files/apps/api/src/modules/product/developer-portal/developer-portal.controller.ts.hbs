import { Body, Controller, Get, Param, Patch, Post } from '@nestjs/common';
import { ApiBearerAuth, ApiOperation, ApiTags } from '@nestjs/swagger';
import { RequirePermissions } from '@trustos/rbac';
import { OrganizationId } from '@trustos/tenancy';
import { z } from '@trustos/validation';
import { ZodValidationPipe } from '@trustos/validation/nest';
import { DEVELOPER_PORTAL_PERMISSIONS as P } from '{{packageName}}-product-domain';
import {
  DeveloperPortalService,
  type ApiApplicationRow,
  type ApiKeyRecordRow,
  type ApiUsageRecordRow,
  type CodeExampleRow,
  type SdkReleaseRow,
} from './developer-portal.service';

/**
 * TrustOS Developer Portal endpoints.
 *
 * Every route declares a permission — `PermissionsGuard` denies any route that declares none —
 * and the key is the same constant the admin console reads to decide whether to show the screen.
 * A guard and a menu reading different lists disagree, and the disagreement is always in the
 * direction of showing somebody a screen that then refuses them.
 *
 * The organization always comes from `@OrganizationId()`, which reads what the tenant guard
 * derived from the access token. It is never read from a path, a body or a header — a tenant id
 * a caller can supply is not a tenant boundary.
 */

const createApiApplicationSchema = z.object({
  name: z.string().trim().min(1).max(255),
  slug: z.string().trim().toLowerCase().min(2).max(64).regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/),
  ownerUserId: z.string().trim().min(1).max(255),
  description: z.string().trim().min(1).max(4000).optional(),
  environment: z.enum(['SANDBOX', 'PRODUCTION']).optional(),
  status: z.enum(['PENDING', 'APPROVED', 'SUSPENDED', 'REVOKED']).optional(),
});

const updateApiApplicationSchema = z
  .object({
    name: z.string().trim().min(1).max(255).optional(),
    ownerUserId: z.string().trim().min(1).max(255).optional(),
    description: z.string().trim().min(1).max(4000).optional(),
    environment: z.enum(['SANDBOX', 'PRODUCTION']).optional(),
    status: z.enum(['PENDING', 'APPROVED', 'SUSPENDED', 'REVOKED']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

