@ApiTags('api-applications')
@ApiBearerAuth('access-token')
@Controller('api-applications')
export class ApiApplicationController {
  constructor(private readonly product: DeveloperPortalService) {}

  @Get()
  @RequirePermissions(P.API_APPLICATION_READ.key)
  @ApiOperation({ summary: 'List applications' })
  list(): Promise<ApiApplicationRow[]> {
    return this.product.listApiApplications();
  }

  @Get(':id')
  @RequirePermissions(P.API_APPLICATION_READ.key)
  @ApiOperation({ summary: 'Read one application' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<ApiApplicationRow> {
    return this.product.findApiApplication(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.API_APPLICATION_CREATE.key)
  @ApiOperation({ summary: 'Create a application' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createApiApplicationSchema))
    body: z.infer<typeof createApiApplicationSchema>,
  ): Promise<ApiApplicationRow> {
    return this.product.createApiApplication(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.API_APPLICATION_UPDATE.key)
  @ApiOperation({ summary: 'Modify a application' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateApiApplicationSchema))
    body: z.infer<typeof updateApiApplicationSchema>,
  ): Promise<ApiApplicationRow> {
    return this.product.updateApiApplication(id, body, organizationId);
  }
}

