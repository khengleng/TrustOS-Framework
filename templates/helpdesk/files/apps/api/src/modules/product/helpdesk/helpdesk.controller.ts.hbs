@ApiTags('ticket-queues')
@ApiBearerAuth('access-token')
@Controller('ticket-queues')
export class TicketQueueController {
  constructor(private readonly product: HelpdeskService) {}

  @Get()
  @RequirePermissions(P.TICKET_QUEUE_READ.key)
  @ApiOperation({ summary: 'List queues' })
  list(): Promise<TicketQueueRow[]> {
    return this.product.listTicketQueues();
  }

  @Get(':id')
  @RequirePermissions(P.TICKET_QUEUE_READ.key)
  @ApiOperation({ summary: 'Read one queue' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<TicketQueueRow> {
    return this.product.findTicketQueue(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.TICKET_QUEUE_CREATE.key)
  @ApiOperation({ summary: 'Create a queue' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createTicketQueueSchema))
    body: z.infer<typeof createTicketQueueSchema>,
  ): Promise<TicketQueueRow> {
    return this.product.createTicketQueue(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.TICKET_QUEUE_UPDATE.key)
  @ApiOperation({ summary: 'Modify a queue' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateTicketQueueSchema))
    body: z.infer<typeof updateTicketQueueSchema>,
  ): Promise<TicketQueueRow> {
    return this.product.updateTicketQueue(id, body, organizationId);
  }
}

