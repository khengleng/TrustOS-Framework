  firstResponseMinutes: z.coerce.number().int(),
  resolutionMinutes: z.coerce.number().int(),
  businessHoursOnly: z.coerce.boolean().optional(),
});

const updateSlaPolicySchema = z
  .object({
    name: z.string().trim().min(1).max(255).optional(),
    priority: z.enum(['LOW', 'NORMAL', 'HIGH', 'URGENT']).optional(),
    firstResponseMinutes: z.coerce.number().int().optional(),
    resolutionMinutes: z.coerce.number().int().optional(),
    businessHoursOnly: z.coerce.boolean().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createTicketSchema = z.object({
  reference: z.string().trim().min(1).max(255),
  queueId: z.string().trim().min(1).max(64),
  assigneeId: z.string().trim().min(1).max(64).optional(),
  requesterName: z.string().trim().min(1).max(255),
  requesterEmail: z.string().trim().toLowerCase().email().max(254).optional(),
  subject: z.string().trim().min(1).max(255),
  body: z.string().trim().min(1).max(4000),
  priority: z.enum(['LOW', 'NORMAL', 'HIGH', 'URGENT']).optional(),
  status: z.enum(['NEW', 'OPEN', 'PENDING', 'RESOLVED', 'CLOSED']).optional(),
  openedAt: z.coerce.date(),
  firstRespondedAt: z.coerce.date().optional(),
  resolvedAt: z.coerce.date().optional(),
});

const updateTicketSchema = z
  .object({
    queueId: z.string().trim().min(1).max(64).optional(),
    assigneeId: z.string().trim().min(1).max(64).optional(),
    requesterName: z.string().trim().min(1).max(255).optional(),
    requesterEmail: z.string().trim().toLowerCase().email().max(254).optional(),
    subject: z.string().trim().min(1).max(255).optional(),
    body: z.string().trim().min(1).max(4000).optional(),
    priority: z.enum(['LOW', 'NORMAL', 'HIGH', 'URGENT']).optional(),
    status: z.enum(['NEW', 'OPEN', 'PENDING', 'RESOLVED', 'CLOSED']).optional(),
    openedAt: z.coerce.date().optional(),
    firstRespondedAt: z.coerce.date().optional(),
    resolvedAt: z.coerce.date().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

const createTicketCommentSchema = z.object({
  ticketId: z.string().trim().min(1).max(64),
  authorUserId: z.string().trim().min(1).max(255).optional(),
  body: z.string().trim().min(1).max(4000),
  isInternal: z.coerce.boolean().optional(),
  postedAt: z.coerce.date(),
});

const updateTicketCommentSchema = z
  .object({
    ticketId: z.string().trim().min(1).max(64).optional(),
    authorUserId: z.string().trim().min(1).max(255).optional(),
    body: z.string().trim().min(1).max(4000).optional(),
