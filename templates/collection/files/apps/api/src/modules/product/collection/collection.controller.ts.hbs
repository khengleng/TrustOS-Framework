@ApiTags('collectors')
@ApiBearerAuth('access-token')
@Controller('collectors')
export class CollectorController {
  constructor(private readonly product: CollectionService) {}

  @Get()
  @RequirePermissions(P.COLLECTOR_READ.key)
  @ApiOperation({ summary: 'List collectors' })
  list(): Promise<CollectorRow[]> {
    return this.product.listCollectors();
  }

  @Get(':id')
  @RequirePermissions(P.COLLECTOR_READ.key)
  @ApiOperation({ summary: 'Read one collector' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<CollectorRow> {
    return this.product.findCollector(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.COLLECTOR_CREATE.key)
  @ApiOperation({ summary: 'Create a collector' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createCollectorSchema))
    body: z.infer<typeof createCollectorSchema>,
  ): Promise<CollectorRow> {
    return this.product.createCollector(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.COLLECTOR_UPDATE.key)
  @ApiOperation({ summary: 'Modify a collector' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateCollectorSchema))
    body: z.infer<typeof updateCollectorSchema>,
  ): Promise<CollectorRow> {
    return this.product.updateCollector(id, body, organizationId);
  }
}

