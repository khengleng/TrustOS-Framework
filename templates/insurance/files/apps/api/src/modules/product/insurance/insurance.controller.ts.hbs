  category: z.enum(['LIFE', 'HEALTH', 'MOTOR', 'PROPERTY', 'TRAVEL']),
  currency: z.string().trim().min(1).max(255),
  basePremium: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  defaultSumInsured: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  isActive: z.coerce.boolean().optional(),
});

const updateInsuranceProductSchema = z
  .object({
    name: z.string().trim().min(1).max(255).optional(),
    category: z.enum(['LIFE', 'HEALTH', 'MOTOR', 'PROPERTY', 'TRAVEL']).optional(),
