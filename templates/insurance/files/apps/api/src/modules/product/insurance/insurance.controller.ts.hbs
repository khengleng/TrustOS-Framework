@ApiTags('policy-holders')
@ApiBearerAuth('access-token')
@Controller('policy-holders')
export class PolicyHolderController {
  constructor(private readonly product: InsuranceService) {}

  @Get()
  @RequirePermissions(P.POLICY_HOLDER_READ.key)
  @ApiOperation({ summary: 'List policyholders' })
  list(): Promise<PolicyHolderRow[]> {
    return this.product.listPolicyHolders();
  }

  @Get(':id')
  @RequirePermissions(P.POLICY_HOLDER_READ.key)
  @ApiOperation({ summary: 'Read one policyholder' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<PolicyHolderRow> {
    return this.product.findPolicyHolder(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.POLICY_HOLDER_CREATE.key)
  @ApiOperation({ summary: 'Create a policyholder' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createPolicyHolderSchema))
    body: z.infer<typeof createPolicyHolderSchema>,
  ): Promise<PolicyHolderRow> {
    return this.product.createPolicyHolder(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.POLICY_HOLDER_UPDATE.key)
  @ApiOperation({ summary: 'Modify a policyholder' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updatePolicyHolderSchema))
    body: z.infer<typeof updatePolicyHolderSchema>,
  ): Promise<PolicyHolderRow> {
    return this.product.updatePolicyHolder(id, body, organizationId);
  }
}

