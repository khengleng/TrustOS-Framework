@ApiTags('programmes')
@ApiBearerAuth('access-token')
@Controller('programmes')
export class ProgrammeController {
  constructor(private readonly product: NgoService) {}

  @Get()
  @RequirePermissions(P.PROGRAMME_READ.key)
  @ApiOperation({ summary: 'List programmes' })
  list(): Promise<ProgrammeRow[]> {
    return this.product.listProgrammes();
  }

  @Get(':id')
  @RequirePermissions(P.PROGRAMME_READ.key)
  @ApiOperation({ summary: 'Read one programme' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<ProgrammeRow> {
    return this.product.findProgramme(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.PROGRAMME_CREATE.key)
  @ApiOperation({ summary: 'Create a programme' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createProgrammeSchema))
    body: z.infer<typeof createProgrammeSchema>,
  ): Promise<ProgrammeRow> {
    return this.product.createProgramme(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.PROGRAMME_UPDATE.key)
  @ApiOperation({ summary: 'Modify a programme' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateProgrammeSchema))
    body: z.infer<typeof updateProgrammeSchema>,
  ): Promise<ProgrammeRow> {
    return this.product.updateProgramme(id, body, organizationId);
  }
}

