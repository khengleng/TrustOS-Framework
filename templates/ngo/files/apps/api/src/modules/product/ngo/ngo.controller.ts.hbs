  name: z.string().trim().min(1).max(255),
  location: z.string().trim().min(1).max(255).optional(),
  budget: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  currency: z.string().trim().min(1).max(255),
  startsOn: z.coerce.date().optional(),
  endsOn: z.coerce.date().optional(),
  status: z.enum(['PLANNED', 'ACTIVE', 'SUSPENDED', 'COMPLETED']).optional(),
});

