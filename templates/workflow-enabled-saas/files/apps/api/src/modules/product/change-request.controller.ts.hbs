import { Body, Controller, Get, Headers, Param, Post, Query } from '@nestjs/common';
import { ApiBearerAuth, ApiOkResponse, ApiOperation, ApiTags } from '@nestjs/swagger';
import { CurrentUser } from '@trustos/auth';
import { PERMISSIONS, RequirePermissions } from '@trustos/rbac';
import type { ActorContext } from '@trustos/shared-types';
import { z } from '@trustos/validation';
import { ZodValidationPipe } from '@trustos/validation/nest';
import { toWorkflowActor, WORKFLOW_PERMISSIONS } from '@trustos/workflow-core';
import { ChangeRequestService } from './change-request.service';
import { ChangeRequestWorkflowService } from './change-request-workflow.service';

/*
 * Request schemas, declared above the controller.
 *
 * A `const` referenced inside a parameter decorator is evaluated when the class is defined,
 * so a schema declared afterwards is a temporal dead zone error.
 */
const pageSchema = z.object({
  page: z.coerce.number().int().min(1).default(1),
  pageSize: z.coerce.number().int().min(1).max(100).default(25),
});

const createSchema = z.object({
  title: z.string().trim().min(3).max(200),
  description: z.string().trim().max(2000).optional(),
  /** Minor units. No floating-point arithmetic anywhere near a decision. */
  amount: z.number().int().min(0),
  riskRating: z.enum(['low', 'medium', 'high']),
  justification: z.string().trim().max(2000).optional(),
});

const decisionSchema = z.object({
  reasonCode: z.string().trim().min(1).max(80).optional(),
  explanation: z.string().trim().max(2000).optional(),
  /** The version the caller read. Refused if the instance has moved on. */
  expectedVersion: z.number().int().min(0).optional(),
});

/**
 * {{productDisplayName}} change requests.
 *
 * The one thing worth studying here is what this controller does *not* do: it never sets a
 * workflow state. `submit`, `approve`, `reject` and `return` all call the engine with an
 * action the definition declares, and the engine decides what that action means.
 *
 * That is what makes the definition the single source of truth. A controller that wrote
 * `currentState` directly would be a second implementation of the workflow, and the two
 * would disagree within a month.
 */
@ApiTags('change-requests')
@ApiBearerAuth('access-token')
@Controller('change-requests')
export class ChangeRequestController {
  constructor(
    private readonly requests: ChangeRequestService,
    private readonly workflow: ChangeRequestWorkflowService,
  ) {}

  @Get()
  @RequirePermissions(PERMISSIONS.ORGANIZATION_READ.key)
  @ApiOperation({ summary: 'List change requests' })
  list(@Query(new ZodValidationPipe(pageSchema)) query: z.infer<typeof pageSchema>) {
    return this.requests.list(query);
  }

  @Get(':id')
  @RequirePermissions(PERMISSIONS.ORGANIZATION_READ.key)
  @ApiOperation({ summary: 'One change request, with its workflow state' })
  @ApiOkResponse({
    description:
      'The available actions come from the definition and the request’s data, so a UI never ' +
      'offers an action the engine would refuse.',
  })
  find(@CurrentUser() actor: ActorContext, @Param('id') id: string) {
    return this.workflow.describe(toWorkflowActor(actor), id);
  }

  @Post()
  @RequirePermissions(PERMISSIONS.ORGANIZATION_READ.key)
  @ApiOperation({ summary: 'Create a change request and start its workflow' })
  @ApiOkResponse({
    description:
      'The record is created first, then the workflow. If the workflow start fails the ' +
      'request exists in draft with no instance, which is recoverable — the reverse would ' +
      'leave an instance pointing at nothing.',
  })
  create(
    @CurrentUser() actor: ActorContext,
    @Body(new ZodValidationPipe(createSchema)) body: z.infer<typeof createSchema>,
    @Headers('idempotency-key') idempotencyKey?: string,
  ) {
    return this.workflow.createAndStart(toWorkflowActor(actor), body, idempotencyKey ?? null);
  }

  @Post(':id/submit')
  @RequirePermissions(WORKFLOW_PERMISSIONS.INSTANCE_TRANSITION.key)
  @ApiOperation({ summary: 'Submit for approval' })
  submit(
    @CurrentUser() actor: ActorContext,
    @Param('id') id: string,
    @Body(new ZodValidationPipe(decisionSchema)) body: z.infer<typeof decisionSchema>,
    @Headers('idempotency-key') idempotencyKey?: string,
  ) {
    return this.workflow.act(toWorkflowActor(actor), id, 'submit', body, idempotencyKey ?? null);
  }

  @Post(':id/approve')
  @RequirePermissions(WORKFLOW_PERMISSIONS.APPROVAL_DECIDE.key)
  @ApiOperation({ summary: 'Approve, or escalate to compliance for a high-risk request' })
  @ApiOkResponse({
    description:
      'Refused for the submitter. Which action applies depends on the risk rating, so the ' +
      'engine is asked rather than told — see `describe`.',
  })
  approve(
    @CurrentUser() actor: ActorContext,
    @Param('id') id: string,
    @Body(new ZodValidationPipe(decisionSchema)) body: z.infer<typeof decisionSchema>,
    @Headers('idempotency-key') idempotencyKey?: string,
  ) {
    return this.workflow.approve(toWorkflowActor(actor), id, body, idempotencyKey ?? null);
  }

  @Post(':id/reject')
  @RequirePermissions(WORKFLOW_PERMISSIONS.APPROVAL_DECIDE.key)
  @ApiOperation({ summary: 'Reject, with a mandatory reason' })
  reject(
    @CurrentUser() actor: ActorContext,
    @Param('id') id: string,
    @Body(new ZodValidationPipe(decisionSchema)) body: z.infer<typeof decisionSchema>,
    @Headers('idempotency-key') idempotencyKey?: string,
  ) {
    return this.workflow.act(toWorkflowActor(actor), id, 'reject', body, idempotencyKey ?? null);
  }

  @Post(':id/return')
  @RequirePermissions(WORKFLOW_PERMISSIONS.APPROVAL_DECIDE.key)
  @ApiOperation({ summary: 'Return to the maker for rework, with a mandatory reason' })
  returnForRework(
    @CurrentUser() actor: ActorContext,
    @Param('id') id: string,
    @Body(new ZodValidationPipe(decisionSchema)) body: z.infer<typeof decisionSchema>,
    @Headers('idempotency-key') idempotencyKey?: string,
  ) {
    return this.workflow.act(
      toWorkflowActor(actor),
      id,
      'return_for_rework',
      body,
      idempotencyKey ?? null,
    );
  }
}
