const createPurchaseRequestSchema = z.object({
  reference: z.string().trim().min(1).max(255),
  departmentId: z.string().trim().min(1).max(64),
  requestedByEmployeeId: z.string().trim().min(1).max(64),
  projectId: z.string().trim().min(1).max(64).optional(),
  description: z.string().trim().min(1).max(4000),
  estimatedAmount: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.'),
  currency: z.string().trim().min(1).max(255),
  workflowInstanceId: z.string().trim().min(1).max(255).optional(),
  status: z.enum(['DRAFT', 'SUBMITTED', 'APPROVED', 'REJECTED', 'ORDERED', 'RECEIVED', 'CANCELLED']).optional(),
  neededBy: z.coerce.date().optional(),
});

const updatePurchaseRequestSchema = z
  .object({
    departmentId: z.string().trim().min(1).max(64).optional(),
    requestedByEmployeeId: z.string().trim().min(1).max(64).optional(),
    projectId: z.string().trim().min(1).max(64).optional(),
    description: z.string().trim().min(1).max(4000).optional(),
    estimatedAmount: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    workflowInstanceId: z.string().trim().min(1).max(255).optional(),
    status: z.enum(['DRAFT', 'SUBMITTED', 'APPROVED', 'REJECTED', 'ORDERED', 'RECEIVED', 'CANCELLED']).optional(),
    neededBy: z.coerce.date().optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
   * client that dropped its body, and a 200 tells it everything worked.
   */
  .refine((body) => Object.keys(body).length > 0, 'No fields to update.');

@ApiTags('departments')
@ApiBearerAuth('access-token')
@Controller('departments')
export class DepartmentController {
  constructor(private readonly product: ErpService) {}

  @Get()
  @RequirePermissions(P.DEPARTMENT_READ.key)
  @ApiOperation({ summary: 'List departments' })
  list(): Promise<DepartmentRow[]> {
    return this.product.listDepartments();
  }

  @Get(':id')
  @RequirePermissions(P.DEPARTMENT_READ.key)
  @ApiOperation({ summary: 'Read one department' })
  find(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
  ): Promise<DepartmentRow> {
    return this.product.findDepartment(id, organizationId);
  }

  @Post()
  @RequirePermissions(P.DEPARTMENT_CREATE.key)
  @ApiOperation({ summary: 'Create a department' })
  create(
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(createDepartmentSchema))
    body: z.infer<typeof createDepartmentSchema>,
  ): Promise<DepartmentRow> {
    return this.product.createDepartment(body, organizationId);
  }

  @Patch(':id')
  @RequirePermissions(P.DEPARTMENT_UPDATE.key)
  @ApiOperation({ summary: 'Modify a department' })
  update(
    @Param('id') id: string,
    @OrganizationId() organizationId: string,
    @Body(new ZodValidationPipe(updateDepartmentSchema))
    body: z.infer<typeof updateDepartmentSchema>,
  ): Promise<DepartmentRow> {
    return this.product.updateDepartment(id, body, organizationId);
  }
}

