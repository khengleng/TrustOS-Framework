    budget: z.string().trim().regex(/^-?\d{1,15}(\.\d{1,8})?$/, 'Must be a decimal amount.').optional(),
    currency: z.string().trim().min(1).max(255).optional(),
    startsOn: z.coerce.date().optional(),
    endsOn: z.coerce.date().optional(),
    status: z.enum(['PLANNED', 'ACTIVE', 'ON_HOLD', 'COMPLETED', 'CANCELLED']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
