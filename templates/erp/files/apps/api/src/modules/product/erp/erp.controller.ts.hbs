  fullName: z.string().trim().min(1).max(255),
  jobTitle: z.string().trim().min(1).max(255).optional(),
  email: z.string().trim().toLowerCase().email().max(254).optional(),
  startedOn: z.coerce.date(),
  status: z.enum(['ACTIVE', 'ON_LEAVE', 'SUSPENDED', 'LEFT']).optional(),
});

const updateEmployeeSchema = z
  .object({
    userId: z.string().trim().min(1).max(255).optional(),
    departmentId: z.string().trim().min(1).max(64).optional(),
    fullName: z.string().trim().min(1).max(255).optional(),
    jobTitle: z.string().trim().min(1).max(255).optional(),
    email: z.string().trim().toLowerCase().email().max(254).optional(),
    startedOn: z.coerce.date().optional(),
    status: z.enum(['ACTIVE', 'ON_LEAVE', 'SUSPENDED', 'LEFT']).optional(),
  })
  /*
   * Refused rather than accepted as a no-op. An empty PATCH is almost always a
