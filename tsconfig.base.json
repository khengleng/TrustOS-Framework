{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@trustos/api-keys": ["packages/api-keys/src/index.ts"],
      "@trustos/audit": ["packages/audit/src/index.ts"],
      "@trustos/auth": ["packages/auth/src/index.ts"],
      "@trustos/authorization": ["packages/authorization/src/index.ts"],
      "@trustos/cli": ["packages/cli/src/index.ts"],
      "@trustos/config": ["packages/config/src/index.ts"],
      "@trustos/database": ["packages/database/src/index.ts"],
      "@trustos/errors": ["packages/errors/src/index.ts"],
      "@trustos/generator-core": ["packages/generator-core/src/index.ts"],
      "@trustos/identity": ["packages/identity/src/index.ts"],
      "@trustos/logging": ["packages/logging/src/index.ts"],
      "@trustos/module-document": ["packages/modules/document/src/index.ts"],
      "@trustos/module-feature-flags": ["packages/modules/feature-flags/src/index.ts"],
      "@trustos/module-file-storage": ["packages/modules/file-storage/src/index.ts"],
      "@trustos/module-notification": ["packages/modules/notification/src/index.ts"],
      "@trustos/module-registry": ["packages/module-registry/src/index.ts"],
      "@trustos/module-reporting": ["packages/modules/reporting/src/index.ts"],
      "@trustos/module-sdk": ["packages/module-sdk/src/index.ts"],
      "@trustos/module-search": ["packages/modules/search/src/index.ts"],
      "@trustos/module-workflow": ["packages/modules/workflow/src/index.ts"],
      "@trustos/observability": ["packages/observability/src/index.ts"],
      "@trustos/rbac": ["packages/rbac/src/index.ts"],
      "@trustos/security-events": ["packages/security-events/src/index.ts"],
      "@trustos/security-policy": ["packages/security-policy/src/index.ts"],
      "@trustos/security-testing": ["packages/security-testing/src/index.ts"],
      "@trustos/service-accounts": ["packages/service-accounts/src/index.ts"],
      "@trustos/session-security": ["packages/session-security/src/index.ts"],
      "@trustos/shared-types": ["packages/shared-types/src/index.ts"],
      "@trustos/template-registry": ["packages/template-registry/src/index.ts"],
      "@trustos/tenancy": ["packages/tenancy/src/index.ts"],
      "@trustos/validation": ["packages/validation/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
