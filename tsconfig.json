{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/modules/*/src/**/*.ts",
    "packages/*/*.config.ts",
    "packages/modules/*.spec.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next", "apps", "templates"]
}
