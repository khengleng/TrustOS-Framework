# =============================================================================
# TrustOS Framework — environment template
#
#   cp .env.example .env
#
# Every variable here is one the code actually reads. Nothing is listed because
# an architecture document mentioned it: a template full of variables nothing
# consumes teaches people to ignore the template.
#
# NEVER commit a filled-in copy. `.env` is gitignored; keep it that way.
# Production values belong in the Railway variable store, and no DEV or UAT
# credential may work in production.
#
# `@trustos/config` validates these at start-up and refuses to boot when a
# required one is missing or a production value is unsafe. That is deliberate:
# a service that starts with a missing secret is a service that fails at the
# first request instead of at deploy time.
# =============================================================================

# --- Required -----------------------------------------------------------------

# development | test | production
NODE_ENV=development

# TrustOS's own environment, separate from NODE_ENV.
#
# A UAT service runs with NODE_ENV=production — that is what the word means to
# Node — so NODE_ENV cannot tell UAT from production. This can, and it is what
# `@trustos/governance-environment-config` refuses a lower-environment
# credential against.
TRUSTOS_ENVIRONMENT=dev

PORT=3000

# PostgreSQL. Railway injects this when a Postgres service is attached — do not
# hardcode it there. Each environment has its own database; UAT never shares
# DEV's.
DATABASE_URL=postgresql://trustos:trustos@localhost:5432/trustos_dev?schema=public

# Signing keys for access and refresh tokens.
#
# They MUST differ and MUST be at least 32 characters in production. The
# security policy refuses to start otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=development-only-jwt-secret-change-me-please
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me-ok

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Service identity ---------------------------------------------------------

SERVICE_NAME=trustos-api
SERVICE_VERSION=0.1.0

# --- Tokens -------------------------------------------------------------------

JWT_ISSUER=trustos
JWT_AUDIENCE=trustos-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_HASH_ROUNDS=12

# --- HTTP ---------------------------------------------------------------------

# Comma-separated. "*" is rejected in production by the security policy.
CORS_ORIGINS=http://localhost:3001

# Enable only behind a proxy you control. Railway sets X-Forwarded-For, so this
# is `true` on Railway and `false` locally — trusting the header without a proxy
# in front lets a caller choose their own source address.
TRUST_PROXY=false

REQUEST_ID_HEADER=x-request-id
API_GLOBAL_PREFIX=api

# Serve Swagger at /docs. Consider disabling in production.
OPENAPI_ENABLED=true

# --- Identity -----------------------------------------------------------------

# local | oidc
#
# `local` is refused in production unless the override below is set. The override
# exists so a deployment can make that choice deliberately and have it recorded,
# not so it can be made accidentally.
IDENTITY_PROVIDER=local
SECURITY_ALLOW_LOCAL_IDENTITY_IN_PRODUCTION=false

# Required when IDENTITY_PROVIDER=oidc.
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/trustos
# OIDC_CLIENT_ID=trustos-api
# OIDC_CLIENT_SECRET=
# OIDC_END_SESSION_ENDPOINT=
#
# Maps OIDC group or role claims to TrustOS roles, as JSON.
# OIDC_ROLE_MAP={"trustos-admin":"platform_admin"}

# --- Security policy ----------------------------------------------------------

SECURITY_TOKEN_ISSUER=trustos
SECURITY_TOKEN_AUDIENCE=trustos-api

# --- Observability ------------------------------------------------------------

OTEL_ENABLED=false
# Required when OTEL_ENABLED=true.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com

# --- Admin console (browser) --------------------------------------------------
#
# NEXT_PUBLIC_* is embedded in the client bundle. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# =============================================================================
# Deliberately absent
#
# REDIS_URL          Nothing in this repository requires Redis. `job-runtime`
#                    and `scheduler` define ports with in-memory implementations,
#                    and the Prisma stores use PostgreSQL. Adding it would be
#                    adding an operational dependency to satisfy a diagram.
#
# OPENAI_API_KEY     `@trustos/ai-gateway` holds no provider client and reads no
# ANTHROPIC_API_KEY  provider environment variable. A deployment binds a provider
# GOOGLE_AI_API_KEY  adapter and that adapter reads its own credentials. See
#                    docs/ai-architecture.md.
#
# ENCRYPTION_KEY     No package in this repository encrypts at rest. Encryption
#                    is the database's and the platform's, and a key here would
#                    be a key nothing uses.
#
# S3_*               `@trustos/export` writes through a port. No implementation
#                    in this repository requires a bucket.
#
# Each of these appears in the readiness specification's example list. They are
# omitted because the specification also says to include only variables the
# current implementation requires, and none of these is read anywhere.
# =============================================================================
