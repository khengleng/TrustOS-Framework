# =============================================================================
# TrustOS Framework — environment template
#
#   cp packages/config/.env.example .env
#
# Never commit a filled-in copy of this file. `.env` is gitignored; keep it
# that way. Production values belong in the Railway variable store.
# =============================================================================

# --- Required -----------------------------------------------------------------

# development | test | production
NODE_ENV=development

PORT=3000

# PostgreSQL connection string. Railway injects this automatically when a
# Postgres plugin is attached — do not hardcode it there.
DATABASE_URL=postgresql://trustos:trustos@localhost:5432/trustos_dev?schema=public

# Signing keys for access and refresh tokens. They MUST be different values and
# at least 32 characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=development-only-jwt-secret-change-me-please
JWT_REFRESH_SECRET=development-only-refresh-secret-change-me-ok

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Optional (defaults shown) ------------------------------------------------

SERVICE_NAME=trustos-api-example
SERVICE_VERSION=0.1.0

JWT_ISSUER=trustos
JWT_AUDIENCE=trustos-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
PASSWORD_HASH_ROUNDS=12

# Comma-separated. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3001
# Enable only behind a proxy you control (Railway sets X-Forwarded-For).
TRUST_PROXY=false
REQUEST_ID_HEADER=x-request-id
API_GLOBAL_PREFIX=api

OTEL_ENABLED=false
# Required when OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com

# Serve Swagger UI at /docs. Consider disabling in production.
OPENAPI_ENABLED=true

# --- Admin example app (browser) ----------------------------------------------
# NEXT_PUBLIC_* values are embedded in the client bundle. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
