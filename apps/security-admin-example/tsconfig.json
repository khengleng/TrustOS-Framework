{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    /**
     * Deliberately empty, for the same reason as api-example: the app resolves
     * framework packages through node_modules, exactly as a real product would.
     * Mapping them back to source would compile package sources into this app and
     * hide a packaging mistake — a missing export, an undeclared subpath — until
     * deployment.
     */
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
