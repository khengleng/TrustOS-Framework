{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npm run build:packages && npm run build -w @trustos/admin-example"
  },
  "deploy": {
    "startCommand": "npm run start -w @trustos/admin-example -- --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
