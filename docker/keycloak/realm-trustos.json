{
  "realm": "trustos",
  "enabled": true,
  "displayName": "TrustOS Platform",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "failureFactor": 10,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(12) and notUsername(undefined) and passwordHistory(3)",
  "roles": {
    "realm": [
      {
        "name": "trustos-organization-owner",
        "description": "Maps to the TrustOS organization_owner role."
      },
      {
        "name": "trustos-administrator",
        "description": "Maps to the TrustOS administrator role."
      },
      {
        "name": "trustos-operator",
        "description": "Maps to the TrustOS operator role."
      },
      {
        "name": "trustos-auditor",
        "description": "Maps to the TrustOS auditor role."
      }
    ]
  },
  "clients": [
    {
      "clientId": "trustos-web",
      "name": "TrustOS Web (public)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://trustos.cambobia.com/*"],
      "webOrigins": ["https://trustos.cambobia.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://trustos.cambobia.com/*"
      },
      "protocolMappers": [
        {
          "name": "audience-trustos-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trustos-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "trustos-organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "trustos_organization",
            "claim.name": "trustos_organization",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "trustos-api",
      "name": "TrustOS API (confidential)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "audience-trustos-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "trustos-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": []
}
